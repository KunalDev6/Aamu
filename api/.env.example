# Copy to api/.env and enter the event key privately. Never paste it in chat.
GEMINI_API_KEY=

# Choose only after authenticated ListModels discovery. No assumed model name.
LLM_MODEL=
# Documented compatible endpoint; verify support using the actual listed model.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Compatible transport was verified with the listed configured Gemma.
LLM_TRANSPORT=compatible
# U28 demo defaults true: diagnostics and the protected live demo clinic routes.
# Set false to remove those routes/fixtures. No distress probabilities are exposed.
DEMO_MODE=true
# Server-only random token (32+ base64url characters); never use the connection code.
# Required only in demo mode; the clinic BFF forwards it, never the browser bundle.
DEMO_DASHBOARD_TOKEN=

# Aiven EU services. Enter credentials privately; never commit api/.env.
DATABASE_URL=
VALKEY_URL=
# Optional PEM CA paths when the service certificate needs an Aiven CA.
DATABASE_CA_PATH=
VALKEY_CA_PATH=
# Required: set 0 for the approved until-used codes; positive values expire in seconds; blank disables code creation.
PAIR_CODE_TTL_SECONDS=
# Laptop-only listener; Cloudflare Quick Tunnel is a separate approved step.
HOST=127.0.0.1
PORT=3000
